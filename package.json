{
  "name": "@glazejs/workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.12.0",
    "pnpm": ">=12.14.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "pnpm install --frozen-lockfile && pnpm exec playwright install chromium",
    "dev": "pnpm --filter @glazejs/playground dev",
    "build": "pnpm -r build",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint . --max-warnings=0 && pnpm audit:workspace && pnpm audit:docs",
    "lint:fix": "oxlint . --fix --max-warnings=0 && pnpm audit:workspace && pnpm audit:docs",
    "typecheck": "tsc-rs --noEmit -p tsconfig.json && pnpm -r typecheck",
    "test": "pnpm test:unit && pnpm test:tooling",
    "test:unit": "pnpm --filter glazejs test",
    "test:tooling": "node --test scripts/*.test.ts scripts/oxlint-plugins/*.test.ts",
    "test:e2e": "playwright test",
    "audit:workspace": "node scripts/check-workspace.ts",
    "audit:docs": "node scripts/check-docs-content.ts --root docs --expected-docs 11 --expected-nav 1",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify": "pnpm check && pnpm test:e2e && pnpm test:package",
    "test:package": "node scripts/check-package.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsc-rs": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:"
  }
}
