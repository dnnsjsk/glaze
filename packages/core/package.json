{
  "name": "glazejs",
  "version": "2.1.0",
  "description": "Declarative animations with GSAP and Motion adapters.",
  "author": "Dennis Josek <hi@dennn.is> (https://dennn.is)",
  "homepage": "https://glaze.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inline0/glaze.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/inline0/glaze/issues"
  },
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "glaze",
    "glazejs",
    "animation",
    "web",
    "utility",
    "gsap",
    "motion"
  ],
  "scripts": {
    "build": "vite build && node scripts/prepare-package.ts",
    "typecheck": "tsc-rs --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@glazejs/shared": "workspace:*",
    "@glazejs/gsap": "workspace:*",
    "@glazejs/motion": "workspace:*",
    "gsap": "catalog:",
    "jsdom": "catalog:",
    "motion": "catalog:",
    "rolldown-plugin-dts": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "type": "module",
  "main": "./dist/index.es.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "default": "./dist/index.es.js"
    },
    "./gsap": {
      "types": "./dist/gsap.d.ts",
      "import": "./dist/gsap.es.js",
      "default": "./dist/gsap.es.js"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "import": "./dist/motion.es.js",
      "default": "./dist/motion.es.js"
    },
    "./dist/index.es.js": "./dist/index.es.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "peerDependencies": {
    "gsap": "^3.15.0",
    "motion": "^14.6.0"
  },
  "peerDependenciesMeta": {
    "gsap": {
      "optional": true
    },
    "motion": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
